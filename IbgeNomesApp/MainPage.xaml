<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="IbgeNomesApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:IbgeNomesApp.Models"
             Title="Nomes mais comuns (Censo 2022)">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Nomes mais comuns por localidade"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />

            <!-- Seleção de localidade -->
            <Label Text="Estado" FontAttributes="Bold" />
            <Picker Title="Selecione um estado"
                    ItemsSource="{Binding Estados}"
                    SelectedItem="{Binding EstadoSelecionado}" />

            <Label Text="Município (opcional)" FontAttributes="Bold"
                   IsVisible="{Binding MunicipiosDisponiveis}" />
            <Picker Title="Selecione um município"
                    ItemsSource="{Binding Municipios}"
                    SelectedItem="{Binding MunicipioSelecionado}"
                    IsVisible="{Binding MunicipiosDisponiveis}" />

            <!-- Carregando -->
            <ActivityIndicator IsRunning="{Binding EstaCarregando}"
                               IsVisible="{Binding EstaCarregando}"
                               Color="{StaticResource Primary}" />

            <!-- Erro / lista vazia -->
            <Label Text="{Binding MensagemErro}"
                   IsVisible="{Binding TemErro}"
                   TextColor="Red"
                   HorizontalTextAlignment="Center" />

            <!-- Resultados -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding TemResultados}">

                <Label Text="{Binding LocalidadeExibida, StringFormat='Resultados para: {0}'}"
                       FontAttributes="Bold" FontSize="18" />

                <Label Text="Homens" FontAttributes="Bold" FontSize="16"
                       TextColor="{StaticResource Primary}" />
                <CollectionView ItemsSource="{Binding Homens}" HeightRequest="430">
                    <CollectionView.EmptyView>
                        <Label Text="Sem dados para esta localidade." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Frequencia">
                            <Label Text="{Binding Descricao}" Padding="8" FontSize="16" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Mulheres" FontAttributes="Bold" FontSize="16"
                       TextColor="{StaticResource Primary}" />
                <CollectionView ItemsSource="{Binding Mulheres}" HeightRequest="430">
                    <CollectionView.EmptyView>
                        <Label Text="Sem dados para esta localidade." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Frequencia">
                            <Label Text="{Binding Descricao}" Padding="8" FontSize="16" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Sobrenomes" FontAttributes="Bold" FontSize="16"
                       TextColor="{StaticResource Primary}" />
                <CollectionView ItemsSource="{Binding Sobrenomes}" HeightRequest="430">
                    <CollectionView.EmptyView>
                        <Label Text="A API não retornou sobrenomes para esta localidade." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Frequencia">
                            <Label Text="{Binding Descricao}" Padding="8" FontSize="16" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
